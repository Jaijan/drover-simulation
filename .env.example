# Frontend build-time URLs. Use https:// and wss:// in production.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/simulation

# Backend runtime settings. Set exact deployed frontend origins, comma separated.
DROVER_CORS_ORIGINS=http://localhost:5173
DROVER_DB_PATH=./drover.sqlite3
# Set a long random secret in production to protect PUT /api/config/{kind}.
DROVER_ADMIN_TOKEN=
